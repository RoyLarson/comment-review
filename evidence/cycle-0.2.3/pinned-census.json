  "start": 142,
  "end": 145,
  "kind": "comment",
  "lines": 4,
  "text": "Group by file, because a splice is a whole-file rewrite. The CENSUS BLOCK travels with each edit: its `raw_lines` is the only record of what the file said when the reviewers read it, and comparing the file to itself would make the staleness check below unable to fail.",
  "anchor": "",
  "tier": "tokenized",
  "annotations": [
   "names-a-symbol"
  ],
  "notes": [],
  "raw_lines": [
   "    # Group by file, because a splice is a whole-file rewrite. The CENSUS BLOCK",
   "    # travels with each edit: its `raw_lines` is the only record of what the",
   "    # file said when the reviewers read it, and comparing the file to itself",
   "    # would make the staleness check below unable to fail."
  ]
 },
