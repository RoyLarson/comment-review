  "kind": "docstring",
  "lines": 6,
  "text": "CRLF if the text uses it anywhere, LF otherwise -- the joiner for a rewrite. ! Taken from the file being spliced, not from the platform. A galley is diffed against its original; a rewrite that normalised the endings would report every line as changed and bury the prose edit.",
  "anchor": "line_endings",
  "tier": "tokenized",
  "annotations": [],
